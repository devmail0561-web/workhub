# Copier ce fichier vers .env puis ajuster si besoin.
#   cp deploy/.env.example deploy/.env
# POSTGRES_PASSWORD est obligatoire : docker compose refuse de démarrer sans.
# Les ports sont publiés sur 127.0.0.1 uniquement.

WORKHUB_ENV=development

# PostgreSQL
# POSTGRES_USER est le compte d'administration utilisé uniquement par le bootstrap.
# L'application utilise workhub_app ; les migrations utilisent workhub_owner.
POSTGRES_USER=workhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workhub
POSTGRES_PORT=5432
WORKHUB_OWNER_PASSWORD=change-me-owner
WORKHUB_APP_PASSWORD=change-me-app
LOG_LEVEL=INFO

# Authentification
# Secret de signature des JWT d'accès : au moins 32 caractères, à remplacer en production.
WORKHUB_SECRET_KEY=change-me-change-me-change-me-32chars
# Passer à true derrière HTTPS ; false permet les tests en HTTP local.
WORKHUB_COOKIE_SECURE=false
WORKHUB_ACCESS_TOKEN_TTL_SECONDS=900
WORKHUB_REFRESH_TOKEN_TTL_SECONDS=2592000

# Ports exposés sur l'hôte (localhost)
API_PORT=8000
WEB_PORT=8080
